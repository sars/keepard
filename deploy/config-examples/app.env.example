# app.env — install as ${PF_CONFIG_DIR}/app.env (default /etc/private-finances/app.env),
# owned by root, mode 600.
#
# Read by three services in compose.yaml:
#   app       the dashboard
#   telegram  the Telegram worker (reads app.env, then telegram.env)
#   worker    the scheduled jobs: imports, exchange rates, reports, assets
#             snapshot (reads app.env, then sync.env)
# So anything two of them need goes here, once.
#
# Rules for every file in this folder:
#   - One KEY=value per line, no quotes needed, no comment after a value.
#   - Leave an optional setting commented out rather than empty: an empty
#     value is not always the same as an absent one (an empty
#     TELEGRAM_LIVE_QUESTIONS_FROM, for example, stops the worker).
#   - A *_FILE setting is a path as the container sees it. The whole
#     configuration directory is mounted at /etc/private-finances, and the
#     credentials directory at /etc/private-finances/credentials, whatever
#     PF_CONFIG_DIR is on the host. Credential files are owned by the
#     private-finances account (PF_UID) with mode 600; the application refuses
#     a key or token file that group or others can read. See
#     docs/credentials.md for where each one comes from.
#   - After editing, recreate the services that read the file:
#     docker compose up -d --force-recreate app telegram
#
# Set by compose.yaml itself — do not add them here, they would be ignored:
#   APP_MODE=postgres, PORT=3300, BIND_ADDRESS=0.0.0.0, RELEASE_SHA (from
#   PF_RELEASE), CREDENTIALS_DIRECTORY=/etc/private-finances/credentials,
#   ENABLEBANKING_SESSION_DIRECTORY=/var/lib/private-finances-consent.

# ---- Database ----------------------------------------------------------------

# Required. The connection to the stack's own PostgreSQL. The user, host and
# database name are fixed by compose.yaml; only the password is yours, and it
# must be the same as POSTGRES_PASSWORD in db.env. Use a password without
# URL-special characters (for example `openssl rand -hex 32`), or URL-encode it.
DATABASE_URL=postgresql://private-finances:change-me-database-password@db:5432/private_finances

# ---- The two household members -----------------------------------------------
# Exactly two members. Member 1 is stored as `rodion` and member 2 as `katya`
# inside the database and in credential file names; nobody sees those keys.
# The older names RODION_EMAIL, RODION_PASSWORD, KATYA_EMAIL, KATYA_PASSWORD,
# TELEGRAM_RODION_USER_ID and TELEGRAM_KATYA_USER_ID still work; when both
# spellings are set, the MEMBER_ one wins.

# Optional, default "Alex". What member 1 is called on every screen and in
# Telegram. The showcase ignores it and always says Alex and Sam.
MEMBER_1_NAME=Alex
# Required. Member 1's sign-in address; must differ from member 2's.
MEMBER_1_EMAIL=alex@example.com
# Required, at least 20 characters, or the dashboard refuses to start. Applied
# at every start: changing it here and recreating `app` is how a password is
# changed (and the only way back in — there is no reset by email). The
# placeholder below is deliberately too short.
MEMBER_1_PASSWORD=change-me

# Optional, default "Sam".
MEMBER_2_NAME=Sam
# Required.
MEMBER_2_EMAIL=sam@example.com
# Required, at least 20 characters.
MEMBER_2_PASSWORD=change-me

# ---- Public address ----------------------------------------------------------

# Required for any install reached by a domain name; optional only if you will
# reach the dashboard through an SSH tunnel to localhost. The HTTPS origin the
# reverse proxy serves, with no path. The dashboard refuses requests carrying
# any other Host header (localhost and 127.0.0.1 on port 3300 always work), the
# bank approval callback is built from it, and Telegram messages link to it.
# Required whenever Enable Banking is configured: the dashboard will not start
# with a bank application but no PUBLIC_ORIGIN.
PUBLIC_ORIGIN=https://finances.example.com

# ---- Telegram (shared by the dashboard and the worker) -----------------------
# Here rather than in telegram.env because the dashboard also sends questions
# when a signed-in member asks it to. The dashboard enables Telegram only when
# all four are set; the telegram service refuses to start without them. See
# docs/telegram-setup.md for creating the bot and finding the IDs.

# Path to the bot token from @BotFather. File owned by PF_UID, mode 600.
#TELEGRAM_BOT_TOKEN_FILE=/etc/private-finances/credentials/telegram-bot-token
# The numeric ID of the private group holding both members and the bot
# (group IDs are negative).
#TELEGRAM_CHAT_ID=-1000000000000
# Each member's numeric Telegram user ID; they must differ. Only these two
# people's messages in that group are accepted.
#MEMBER_1_TELEGRAM_USER_ID=100000001
#MEMBER_2_TELEGRAM_USER_ID=100000002

# ---- Enable Banking (Wise, Revolut, Swedbank, LHV) ---------------------------
# Optional; leave all four out to use Monobank only. Read by the dashboard (the
# bank approval flow) and by the import jobs. Each member's pair must be
# complete: an application ID without a key file, or the reverse, stops the
# dashboard. Member 2 never falls back to member 1's application. The key file
# is the private PEM downloaded when the application was registered in the
# Enable Banking control panel; the redirect URL registered there is
# PUBLIC_ORIGIN + /connections/enablebanking/callback. See docs/credentials.md.
# (The older unprefixed ENABLEBANKING_APPLICATION_ID and
# ENABLEBANKING_PRIVATE_KEY_FILE are still read, for member 1 only, with the
# key defaulting to credentials/enablebanking.pem.)

# Member 1's Enable Banking application ID (a UUID).
#ENABLEBANKING_RODION_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# Absolute path to member 1's private PEM. Owned by PF_UID, mode 600.
#ENABLEBANKING_RODION_PRIVATE_KEY_FILE=/etc/private-finances/credentials/enablebanking.pem
# Member 2's application ID.
#ENABLEBANKING_KATYA_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# Absolute path to member 2's private PEM. Owned by PF_UID, mode 600.
#ENABLEBANKING_KATYA_PRIVATE_KEY_FILE=/etc/private-finances/credentials/enablebanking-katya.pem

# ---- Monobank ----------------------------------------------------------------
# Monobank needs no setting here: each member's personal API token is a file in
# the credentials directory, with fixed names — credentials/monobank-rodion-token
# for member 1 and credentials/monobank-kate-token for member 2 ("kate", not
# "katya"). Owned by PF_UID, mode 600.

# Optional, default: jars are imported. Set to false to import regular accounts
# only. Read by the import jobs and by the dashboard (which says which applies).
#MONOBANK_INCLUDE_JARS=false

# ---- OpenAI (classification suggestions and receipt reading) -----------------
# Optional; without a key nothing is sent to a model and every classification
# is manual. Read by the dashboard, the Telegram worker and the manual
# categorize job. See docs/credentials.md and docs/llm-budget.md.

# Path to an OpenAI API project key. Owned by PF_UID, mode 600.
#OPENAI_API_KEY_FILE=/etc/private-finances/credentials/openai-api-key
# The model to use. Required for the dashboard's suggestions (no default
# there); the worker's receipt reading defaults to gpt-5.4-mini.
#OPENAI_MODEL=gpt-5.4-mini
# Optional, default 50. The application's own cap on model requests per day.
#OPENAI_MAX_REQUESTS_PER_DAY=50
# Optional. The key's expiry, as a date (YYYY-MM-DD) or an instant
# (OPENAI_API_KEY_EXPIRES_AT=2027-01-31T00:00:00Z); either one. Drives the
# 5/2/1-day reminders on System health and in Telegram (docs/credential-health.md).
#OPENAI_API_KEY_EXPIRES_ON=2027-01-31

# ---- Holdings feeds (Assets) -------------------------------------------------
# Optional. The broker and exchange feeds need no setting here, only files in
# the credentials directory, each optional and owned by PF_UID, mode 600:
# ibkr-flex-token and ibkr-flex-query (Interactive Brokers Flex Web Service),
# binance-api-key and binance-api-secret (a read-only Binance key). Both
# providers can restrict a key to the server's address. See docs/assets.md.

# Optional, default https://ethereum-rpc.publicnode.com. The Ethereum node used
# to read wallet balances. Read by the dashboard and the assets snapshot job.
#ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional. When the IBKR Flex token expires, as an instant or, as
# IBKR_FLEX_TOKEN_EXPIRES_ON, a date. Drives the same expiry reminders.
#IBKR_FLEX_TOKEN_EXPIRES_AT=2027-01-31T00:00:00Z

# ---- Not on a container host -------------------------------------------------
# BACKUP_DIRECTORY belongs to the older systemd deployment's local dumps. Leave
# it unset here: nothing in the container stack writes there, and setting it
# makes Home report that no database backup has been taken.
