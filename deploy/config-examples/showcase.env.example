# showcase.env — install as ${PF_CONFIG_DIR}/showcase.env
# (default /etc/private-finances/showcase.env), owned by root, mode 600.
#
# Read by one service in compose.yaml: showcase, the demo workspace filled
# with an invented household (docs/showcase.md). It is the only file the
# showcase is given, and it must exist even if you never start the showcase:
# compose refuses a missing env_file. Never copy household settings or
# credentials into it.
#
# Set by compose.yaml — do not add them here: APP_MODE=demo, PORT=3301,
# BIND_ADDRESS=0.0.0.0, RELEASE_SHA, DEMO_DATA_DIR, and PUBLIC_ORIGIN, which
# comes from PF_SHOWCASE_ORIGIN in the stack's .env (compose.env.example).

# ---- The operator's sign-in --------------------------------------------------

# Required whenever the showcase is reachable from the internet. Without a
# password the demo signs every visitor in automatically, with the power to
# refill it for everyone. At least 20 characters. This account (member 1 in
# the demo) may also refill the workspace and change its settings.
DEMO_LOGIN_PASSWORD=change-me
# Optional, default demo@example.com. The address typed on the sign-in screen.
DEMO_LOGIN_EMAIL=demo@example.com

# ---- A visitor sign-in you may publish ----------------------------------------

# Optional. A second account (member 2 in the demo) that can look around and
# classify, but not rebuild the workspace. Only created when the password is
# set; at least 20 characters.
#DEMO_VISITOR_PASSWORD=change-me
# Optional, default visitor@example.com.
#DEMO_VISITOR_EMAIL=visitor@example.com
