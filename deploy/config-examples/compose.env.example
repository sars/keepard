# compose.env — install as `.env` next to compose.yaml on the host
# (/opt/private-finances/.env, the directory the host units and the release
# script expect), mode 644. Nothing in it is secret.
#
# Not read by any application process. Docker Compose reads it to fill in the
# ${PF_*} references in compose.yaml, and deploy/container-release-remote.sh
# reads PF_RELEASE, PF_PORT, PF_CONFIG_DIR and PF_SERVICES from it. Every
# `docker compose` command must run in that directory (the host units set
# WorkingDirectory=/opt/private-finances for this reason).

# ---- The image ---------------------------------------------------------------

# Optional, default "local". The tag of the image the services run,
# private-finances:<PF_RELEASE>, and the release the dashboard reports on
# /health/ready. Best set to the full 40-character commit you built
# (`git rev-parse HEAD`), so the dashboard says which code it runs. The
# release script treats a value that is not a commit as a host that has never
# had a release, and rewrites this line at every release.
PF_RELEASE=local

# ---- The account the containers run as ---------------------------------------

# Optional, default 1000 and 1000, which is rarely right. The numeric user and
# group of the host account that owns the credential files and the state
# directories (`id -u private-finances`, `id -g private-finances`). Every
# application container runs as this pair, so files keep their host owners.
PF_UID=1000
PF_GID=1000

# ---- Host directories --------------------------------------------------------

# Optional, default /etc/private-finances. Holds app.env, db.env, telegram.env,
# sync.env, showcase.env, credentials/ and schedules/; mounted read-only into
# the containers at /etc/private-finances. The host units and the release
# script assume the default; change it only if you also change them.
#PF_CONFIG_DIR=/etc/private-finances
# Optional, default /var/lib/private-finances. Its subdirectories consent/,
# sync/ and showcase/ must exist and belong to PF_UID before the stack starts
# (Docker would otherwise create them owned by root). The showcase reseed path
# unit hard-codes the default.
#PF_STATE_DIR=/var/lib/private-finances

# ---- Ports on the host's loopback interface ----------------------------------

# Optional, default 3300. The dashboard is published on 127.0.0.1 only. Keep
# 3300: the dashboard accepts the Host header 127.0.0.1:3300 or localhost:3300
# and no other local port, so the release script's readiness check (and an SSH
# tunnel to any other port) would be refused.
#PF_PORT=3300
# Optional, default 3301. The showcase, also loopback only; the same caveat.
#PF_SHOWCASE_PORT=3301

# ---- The showcase's public name ----------------------------------------------

# Optional, default empty (no Host check). The HTTPS origin the showcase is
# served at, for example https://demo.example.com; passed to the showcase as
# PUBLIC_ORIGIN, and any other Host is then refused.
#PF_SHOWCASE_ORIGIN=https://demo.example.com

# ---- Read by Docker Compose and the release script, not interpolated ---------

# Optional. The compose files every command in this directory uses. Add the
# edge override once the reverse proxy in deploy/edge is running (it needs the
# external `edge` network to exist).
#COMPOSE_FILE=compose.yaml:deploy/compose.edge.yaml
# Optional, default "app telegram showcase". The services
# deploy/container-release.sh recreates at each release, and must find running
# afterwards. Name only what you run: a release that starts an unconfigured
# Telegram worker, or waits for a showcase you do not run, rolls itself back.
#PF_SERVICES=app
