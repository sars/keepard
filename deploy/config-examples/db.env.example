# db.env — install as ${PF_CONFIG_DIR}/db.env (default /etc/private-finances/db.env),
# owned by root, mode 600.
#
# Read by one service in compose.yaml: db (the postgres:16 image).
# POSTGRES_USER=private-finances and POSTGRES_DB=private_finances are set by
# compose.yaml; do not add them here.

# ---- Database password -------------------------------------------------------

# Required. The password of the database's owner role. DATABASE_URL in app.env
# must carry exactly the same value. Generate one without URL-special
# characters, for example: openssl rand -hex 32
#
# PostgreSQL applies it only when the `pgdata` volume is first created. Changing
# it here afterwards changes nothing inside the database; to rotate it, run
# ALTER ROLE through `docker compose exec db psql -U private-finances
# private_finances` and then update both files.
POSTGRES_PASSWORD=change-me-database-password
