# Copy to .env on the server. The names are public; the hash is bcrypt, made
# with `docker compose exec caddy caddy hash-password`, and the password it
# stands for lives with the operator, not on the server. Every variable must
# be set: an empty site name breaks the whole Caddyfile, every project's.
PF_DOMAIN=finances.example.com
PF_DEMO_DOMAIN=demo.example.com
PF_DEMO_USER=demo
PF_DEMO_PASSWORD_HASH=$2a$14$replace-with-caddy-hash-password-output
